<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/instrumentLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

    <Spinner
        android:id="@+id/spinnerInstrument"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:entries="@array/instruments" />

    <Spinner
        android:id="@+id/spinnerBasePitch"
        android:layout_width="0dp"
        android:layout_height="40dp"
        android:layout_weight="1"
        android:entries="@array/base_pitches" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/keyModeLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="4dp">

        <Spinner
            android:id="@+id/spinnerChordRoot"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:entries="@array/chord_roots" />

        <Switch
            android:id="@+id/switchChordType"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="Major / Minor"
            android:layout_marginStart="16dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/modeControlLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp">
        <Switch
            android:id="@+id/switchTuningMode"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:text="純正律 / 平均律" />
    </LinearLayout>

    <TextView
        android:id="@+id/textResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:paddingTop="8dp"
        android:textSize="14sp"
        android:text="選択内容と計算結果がここに表示されます" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp"
        android:layout_marginBottom="4dp">

        <LinearLayout
            android:id="@+id/noteButtonContainer"
            android:background="#000000"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp" />
    </ScrollView>

    <LinearLayout
        android:id="@+id/octaveControlLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="4dp">

        <Button
            android:id="@+id/buttonOctaveDown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="オクターブ下げ" />

        <Button
            android:id="@+id/buttonOctaveUp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="オクターブ上げ"
            android:layout_marginStart="16dp" />

    </LinearLayout>

    <Button
        android:id="@+id/buttonStop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="停止" />

</LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
