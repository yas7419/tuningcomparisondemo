<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

<LinearLayout
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/instrumentLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="2dp">

    <Spinner
        android:id="@+id/spinnerInstrument"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_weight="1"
        android:entries="@array/instruments" />

    <Spinner
        android:id="@+id/spinnerBasePitch"
        android:layout_width="0dp"
        android:layout_height="36dp"
        android:layout_weight="1"
        android:entries="@array/base_pitches" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/keyModeLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="2dp">

        <Spinner
            android:id="@+id/spinnerChordRoot"
            android:layout_width="0dp"
            android:layout_height="36dp"
            android:layout_weight="1"
            android:entries="@array/chord_roots" />

        <Switch
            android:id="@+id/switchChordType"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="Major / Minor"
            android:layout_marginStart="16dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/modeControlLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp">
        <Switch
            android:id="@+id/switchTuningMode"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:text="純正律 / 平均律" />
    </LinearLayout>

    <TextView
        android:id="@+id/textResult"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:text="選択内容と計算結果がここに表示されます" />

    <!-- 中段：鍵盤風12音ボタン配置（横向き：上段＝#・♭、下段＝ナチュラル） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="#000000"
        android:gravity="center"
        android:layout_marginTop="2dp"
        android:layout_marginBottom="2dp"
        android:padding="2dp">

        <LinearLayout
            android:id="@+id/upperRowContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="2dp" />

        <LinearLayout
            android:id="@+id/lowerRowContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="2dp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/octaveControlLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginBottom="2dp">

        <Button
            android:id="@+id/buttonOctaveDown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="オクターブ下げ" />

        <Button
            android:id="@+id/buttonOctaveUp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="オクターブ上げ"
            android:layout_marginStart="16dp" />

    </LinearLayout>

    <Button
        android:id="@+id/buttonStop"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="停止" />

    <Button
        android:id="@+id/debugToggleUiUpdatesButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:text="UI更新/更新停止" />

</LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
