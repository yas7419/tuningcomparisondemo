<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="8dp">

        <!-- 1段目：コントロールバー（1行に集約） -->
        <LinearLayout
            android:id="@+id/topControlLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="2dp">

            <!-- 事前設定グループ -->
            <Spinner
                android:id="@+id/spinnerInstrument"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:entries="@array/instruments" />

            <Spinner
                android:id="@+id/spinnerBasePitch"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:entries="@array/base_pitches" />

            <!-- ★新設：音部記号 Spinner -->
            <Spinner
                android:id="@+id/spinnerClef"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:entries="@array/clefs" />

            <!-- アクティブ操作グループ -->
            <Spinner
                android:id="@+id/spinnerChordRoot"
                android:layout_width="0dp"
                android:layout_height="36dp"
                android:layout_weight="1"
                android:entries="@array/chord_roots" />

            <Switch
                android:id="@+id/switchChordType"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="Maj/Min"
                android:layout_marginStart="8dp" />

            <Switch
                android:id="@+id/switchTuningMode"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="純正/平均"
                android:layout_marginStart="8dp" />

            <Switch
                android:id="@+id/switchSeventhMode"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="自然7度"
                android:checked="true"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- 2段目：楽譜ビューエリア (Custom View) -->
        <com.example.tuningcomparisondemo.StaffScoreView
            android:id="@+id/staffScoreView"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:background="#FFFFF8"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="4dp" />

        <!-- 3段目：アクションバー（1行に集約） -->
        <LinearLayout
            android:id="@+id/bottomActionLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <Button
                android:id="@+id/buttonOctaveDown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="オクターブ下げ" />

            <Button
                android:id="@+id/buttonOctaveUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="オクターブ上げ"
                android:layout_marginStart="8dp" />

            <Space
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1" />

            <Button
                android:id="@+id/buttonStop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="停止" />
        </LinearLayout>

    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>